# LuxLedger Environment Variables
#
# VITE_ prefixed vars are bundled into client-side JS (public).
# Non-VITE_ vars are server-only (Vercel serverless functions).

# ── Client-side (VITE_ prefix = public, visible in browser) ──

# XUMM public API key (safe for client)
VITE_XUMM_API_KEY=your_xumm_api_key

# XRPL Network Configuration (testnet or mainnet)
VITE_XRPL_NETWORK=testnet

# Official XRP Wallet Address (used for payments and escrow)
VITE_XRP_ADDRESS=rYourXRPAddressHere

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional Configuration
VITE_WEB3_ALIAS=luxledger.crypto
VITE_SUPPORT_EMAIL=support@luxledger.io
VITE_LAUNCH_MODE=beta

# ── Server-side only (set in Vercel dashboard, NOT here) ──

# XUMM API Secret — NEVER use VITE_ prefix for secrets
# XUMM_API_KEY=your_xumm_api_key
# XUMM_API_SECRET=your_xumm_api_secret
